<div class="min-h-screen bg-slate-50">
  <nav class="bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between">
    <h1 class="text-xl font-serif font-bold text-slate-800">
      Quis ut Deus<span class="text-amber-500">?</span>
    </h1>
    <div class="flex items-center gap-4">
      <%= link_to "Dashboard", dashboard_path, class: "text-sm text-slate-500 hover:text-slate-800 transition-colors" %>
    </div>
  </nav>

  <main class="max-w-2xl mx-auto px-6 py-10">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold text-slate-800">Prayer Habits</h2>
      <%= link_to "Add Habit", new_prayer_habit_path,
          class: "text-sm bg-amber-500 hover:bg-amber-400 text-white font-semibold px-4 py-2 rounded-lg transition-colors" %>
    </div>

    <% if notice.present? %>
      <p class="text-sm text-green-600 bg-green-50 border border-green-200 rounded-lg px-4 py-3 mb-6"><%= notice %></p>
    <% end %>

    <% if @prayer_habits.any? %>
      <ul class="space-y-3">
        <% @prayer_habits.each do |habit| %>
          <li class="bg-white rounded-xl border border-slate-200 p-5 flex items-start justify-between gap-4">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-semibold text-slate-800"><%= habit.name %></span>
                <span class="text-xs px-2 py-0.5 rounded-full <%= habit.active? ? 'bg-green-100 text-green-700' : 'bg-slate-100 text-slate-500' %>">
                  <%= habit.frequency %>
                </span>
              </div>
              <% if habit.description.present? %>
                <p class="text-sm text-slate-500"><%= habit.description %></p>
              <% end %>
              <% streak = habit.current_streak %>
              <% if streak > 0 %>
                <p class="text-xs text-amber-600 mt-1">&#x1F525; <%= streak %> day streak</p>
              <% end %>
            </div>
            <%= button_to prayer_habit_path(habit), method: :delete,
                data: { turbo_confirm: "Remove \"#{habit.name}\"?" },
                class: "text-sm text-slate-400 hover:text-red-500 transition-colors flex-shrink-0" do %>
              Remove
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="text-center py-16 text-slate-400">
        <p class="mb-4">No habits yet. Start by adding one.</p>
        <%= link_to "Add your first habit", new_prayer_habit_path,
            class: "text-amber-600 hover:text-amber-500 font-medium" %>
      </div>
    <% end %>
  </main>
</div>
