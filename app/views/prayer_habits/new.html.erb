<div class="min-h-screen bg-slate-50">
  <nav class="bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between">
    <h1 class="text-xl font-serif font-bold text-slate-800">
      Quis ut Deus<span class="text-amber-500">?</span>
    </h1>
    <div class="flex items-center gap-4">
      <%= link_to "Back", prayer_habits_path, class: "text-sm text-slate-500 hover:text-slate-800 transition-colors" %>
    </div>
  </nav>

  <main class="max-w-lg mx-auto px-6 py-10">
    <h2 class="text-2xl font-bold text-slate-800 mb-8">New Prayer Habit</h2>

    <%= form_with model: @prayer_habit, class: "bg-white rounded-xl border border-slate-200 p-6 space-y-5" do |f| %>
      <% if @prayer_habit.errors.any? %>
        <div class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-4 py-3">
          <% @prayer_habit.errors.full_messages.each do |msg| %>
            <p><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "Name", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_field :name, placeholder: "e.g. Morning Rosary",
            class: "w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400" %>
      </div>

      <div>
        <%= f.label :description, "Description (optional)", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_area :description, rows: 2, placeholder: "A short note about this habit",
            class: "w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400" %>
      </div>

      <div>
        <%= f.label :frequency, "Frequency", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.select :frequency, [["Daily", "daily"], ["Weekly", "weekly"]],
            { selected: "daily" },
            class: "w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400" %>
      </div>

      <div class="pt-2">
        <%= f.submit "Add Habit",
            class: "w-full bg-amber-500 hover:bg-amber-400 text-white font-semibold px-4 py-2 rounded-lg transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </main>
</div>
