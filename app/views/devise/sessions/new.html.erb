
<div class="min-h-screen bg-gradient-to-br from-[#5E0006] via-[#9B0F06] to-[#D53E0F] flex flex-col items-center justify-center px-4">

  <div class="w-full max-w-sm">

    <%# Logo / Icon %>
    <div class="flex justify-center mb-6">
      <div class="w-16 h-16 rounded-full bg-[#EED9B9]/10 border border-[#EED9B9]/20 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-[#EED9B9]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v3m0 12v3M3 12h3m12 0h3M6.343 6.343l2.122 2.122m7.07 7.07 2.122 2.122M6.343 17.657l2.122-2.122m7.07-7.07 2.122-2.122" />
        </svg>
      </div>
    </div>

    <%# Heading %>
    <h1 class="text-4xl font-bold text-center text-[#EED9B9] tracking-tight mb-1">Quis ut Deus?</h1>
    <p class="text-center text-[#EED9B9]/50 text-xs mb-8 tracking-[0.2em] uppercase">Sign in to continue</p>

    <%# Card %>
    <div class="bg-[#5E0006]/60 border border-[#EED9B9]/10 rounded-2xl p-8 backdrop-blur-sm shadow-2xl">

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { data: { turbo: false } }) do |f| %>

        <div class="mb-5">
          <%= f.label :email, "Email", class: "block text-xs font-semibold text-[#EED9B9]/60 mb-1.5 tracking-widest uppercase" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
              placeholder: "you@example.com",
              class: "w-full bg-black/20 text-[#EED9B9] placeholder-[#EED9B9]/25 border border-[#EED9B9]/15 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-[#D53E0F] focus:bg-black/30 transition duration-200" %>
        </div>

        <div class="mb-5">
          <%= f.label :password, "Password", class: "block text-xs font-semibold text-[#EED9B9]/60 mb-1.5 tracking-widest uppercase" %>
          <%= f.password_field :password, autocomplete: "current-password",
              placeholder: "••••••••",
              class: "w-full bg-black/20 text-[#EED9B9] placeholder-[#EED9B9]/25 border border-[#EED9B9]/15 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-[#D53E0F] focus:bg-black/30 transition duration-200" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2 mb-6">
            <%= f.check_box :remember_me, class: "w-4 h-4 rounded accent-[#D53E0F] cursor-pointer" %>
            <%= f.label :remember_me, "Remember me", class: "text-xs text-[#EED9B9]/50 cursor-pointer tracking-wide" %>
          </div>
        <% end %>

        <div class="mt-6">
          <%= f.submit "Sign in", class: "w-full bg-[#EED9B9] hover:bg-white text-[#5E0006] font-bold text-sm tracking-widest uppercase py-3 rounded-xl transition duration-200 cursor-pointer shadow-lg hover:shadow-xl" %>
        </div>

      <% end %>

    </div>

    <%# Footer links %>
    <div class="mt-6 text-center text-xs text-[#EED9B9]/40 space-y-1">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>
