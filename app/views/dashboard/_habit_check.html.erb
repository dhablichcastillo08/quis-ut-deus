<%= turbo_frame_tag "habit_#{habit.id}_check" do %>
  <% if habit.completed_today? %>
    <%= button_to today_prayer_habit_prayer_logs_path(habit), method: :delete,
        class: "w-5 h-5 rounded-full bg-amber-500 border-2 border-amber-500 flex items-center justify-center text-white text-xs hover:bg-amber-400 transition-colors",
        data: { turbo_frame: "habit_#{habit.id}_check" } do %>
      &#10003;
    <% end %>
  <% else %>
    <%= button_to prayer_habit_prayer_logs_path(habit), method: :post,
        class: "w-5 h-5 rounded-full border-2 border-slate-300 hover:border-amber-400 transition-colors",
        data: { turbo_frame: "habit_#{habit.id}_check" } do %>
    <% end %>
  <% end %>
<% end %>
